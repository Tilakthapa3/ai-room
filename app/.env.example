# Copy this file to app/.env and fill in the values you create below.
# Never commit app/.env — it holds secrets.

# Public URL of this app. For testing on your own computer this is
# http://localhost:8080. In production it must be https://your-domain.
APP_BASE_URL=http://localhost:8080

# Long random string for signing session cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# --- Google sign-in (free) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Apple sign-in (needs a paid Apple Developer account) ---
# Service ID, e.g. com.example.airoom.signin
APPLE_CLIENT_ID=
# 10-character Team ID from developer.apple.com/account
APPLE_TEAM_ID=
# Key ID of the Sign in with Apple key you create
APPLE_KEY_ID=
# Path to the downloaded .p8 key file (keep it private, never commit it)
APPLE_KEY_FILE=
# Bundle ID of the App ID that has the Sign in with Apple capability,
# e.g. com.example.airoom — used for the apple-app-site-association file
APPLE_APP_ID=
