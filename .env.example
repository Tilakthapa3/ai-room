# Copy this file to .env and fill in the keys you want to use.
# Never commit .env. Keys are billed per use by their providers.
# Model IDs change over time; override any default here if yours differs.

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

XAI_API_KEY=
# XAI_MODEL=grok-4-1-fast

DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/auto
# OpenRouter needs a full model slug (e.g. a provider/model slug);
# openrouter/auto is a router fallback, not a specific model.

# Local model via Ollama (no key; nothing leaves your machine).
# Only used when OLLAMA_ENABLED is true.
# OLLAMA_ENABLED=true
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
